{{!
    @template local_feedbackexpander/modal_body

    Body of the feedback expander modal.

    Context variables required:
    * textareaid - Unique ID for the textarea element
    * currentvalue - Current feedback text (escaped)

    Example context (json):
    {
        "textareaid": "feedbackexpander-textarea-1",
        "currentvalue": "<p>Well done.</p>"
    }
}}
<div class="feedbackexpander-modal-body p-2">
    <label class="sr-only" for="{{textareaid}}">{{#str}}feedbacktext, local_feedbackexpander{{/str}}</label>
    <textarea id="{{textareaid}}"
              name="{{textareaid}}"
              class="form-control feedbackexpander-textarea"
              rows="20">{{currentvalue}}</textarea>
</div>
